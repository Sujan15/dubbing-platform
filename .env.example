# .env.example
# Hindi AI Dubbing Platform - configuration

# ---- TTS: Parler primary, IndicF5 secondary -----------------------------------
TTS_ENGINES_ENABLED=parler,indicf5
PARLER_MODEL=ai4bharat/indic-parler-tts
PARLER_REVISION=
PARLER_PYTHON=
INDICF5_MODEL=ai4bharat/IndicF5
INDICF5_REVISION=
INDICF5_PYTHON=

# Seconds of clean speech cut per speaker for cloning (3-30)
SPEAKER_REFERENCE_SECONDS=10

# ---- Projects, human review, voice library ------------------------------------
# true: project uploads stop at awaiting_review before any TTS
PROJECT_REVIEW_ENABLED=true
# Defaults to <DATA_DIR>\default_voices when empty
DEFAULT_VOICES_DIR=
# Clean speech a speaker needs before cloning is considered reliable
MIN_SPEAKER_REFERENCE_SECONDS=6
# Sample rate library references are normalised to: 16000 | 22050 | 24000
SPEAKER_REFERENCE_SAMPLE_RATE=22050
MAX_REFERENCE_UPLOAD_MB=50

# ---- Timing -------------------------------------------------------------------
# Speed-ups up to this fraction are applied directly (0.15 = 15 %)
TIMING_ATEMPO_THRESHOLD=0.15
# LLM "shorten and regenerate" attempts for machine lines that are too long (human-edited lines are never rewritten)
TIMING_MAX_REFINE_ATTEMPTS=2
# Hard cap on pitch-preserving speed-up; TIMING_MAX_SPEEDUP is accepted as an alias
TIMING_MAX_ATEMPO=1.30
# Native speaking-rate cap tried before atempo; 1.0 disables it
TIMING_MAX_TTS_SPEED=1.0
# Seconds a line may run past its original end into silence (never into the next line); 0.3-0.5 sounds more natural
TIMING_MAX_OVERFLOW_SECONDS=0.0
LOUDNESS_MATCH_MAX_DB=9

# ---- Mixing / muxing: preserve_background | dub_only | original_plus_dub ------
DEFAULT_MIX_MODE=preserve_background
DUCK_DB=-18
MIX_SAMPLE_RATE=44100
OUTPUT_AUDIO_BITRATE=192k
